PORT=8787
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
AI_SECRET_MASTER_KEY=replace-with-base64-encoded-32-byte-key
AUTH_SITE_URL=http://localhost:3000
ALLOWED_PROVIDER_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.moonshot.cn,api.moonshot.ai
ALLOWED_LOCAL_PROVIDER_HOSTS=127.0.0.1:11434,localhost:11434
AI_DAILY_USER_LIMIT=20
# Platform-funded VIP analysis is separate from existing BYOK and disabled until
# a verified enabled task/model/provider/encrypted server key is configured.
MEMBERSHIP_MANAGED_AI_ENABLED=false
# Read-only on-chain VIP receipt verification; also requires enabled SQL routes
# with real public receiving addresses and the separate checkout Edge Function.
MEMBERSHIP_WALLET_ENABLED=false
MEMBERSHIP_WALLET_ETHEREUM_RPC_URL=
MEMBERSHIP_WALLET_BASE_RPC_URL=
MEMBERSHIP_WALLET_RPC_ALLOWED_HOSTS=
MEMBERSHIP_WALLET_TRONGRID_API_KEY=
MEMBERSHIP_WALLET_VERIFY_BATCH_SIZE=2
AI_MAX_IMAGE_BYTES=10485760
ALLOWED_WEB_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
BINANCE_FUTURES_API_URL=https://fapi.binance.com
TRADING_SYNC_MINUTES=15
# Business mail is separate from Supabase authentication mail. Server-only.
# Enable only after configuring a verified sender; disabled workers do not claim jobs.
MENTOR_EMAIL_ENABLED=false
MENTOR_EMAIL_API_KEY=
MENTOR_EMAIL_FROM=
MENTOR_EMAIL_SITE_URL=https://wavekb.com
MENTOR_EMAIL_POLL_SECONDS=15
# Dedicated YouTube OAuth application and encryption key; all values server-only.
# Disabled until Google OAuth and the database migration are configured.
YOUTUBE_SYNC_ENABLED=false
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://wavekb.com/api/youtube/callback
YOUTUBE_TOKEN_MASTER_KEY=
YOUTUBE_SYNC_POLL_SECONDS=600
YOUTUBE_SYNC_MAX_PAGES_PER_CONNECTION=2
YOUTUBE_SYNC_MAX_CALLS_PER_POLL=20
YOUTUBE_SYNC_BATCH_SIZE=50
