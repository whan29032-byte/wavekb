{
  "name": "wavekb",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "tline:research": "node --experimental-strip-types scripts/tline-research.mjs",
    "tline:sync": "node scripts/tline-sync.mjs",
    "tline:worker:smoke": "node scripts/smoke-tline-worker.mjs",
    "dev": "pnpm --filter @wavekb/web dev",
    "build": "pnpm --filter @wavekb/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "node --test tests/*.test.mjs && pnpm -r --if-present test",
    "test:web": "pnpm --filter @wavekb/web test",
    "test:e2e": "pnpm --filter @wavekb/web test:e2e",
    "storybook": "pnpm --filter @wavekb/web storybook",
    "storybook:build": "pnpm --filter @wavekb/web storybook:build",
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "knowledge:extract": "node scripts/build-knowledge.mjs",
    "knowledge:coverage": "node scripts/build-knowledge-coverage.mjs",
    "knowledge:sync-primary-refs": "node scripts/sync-reviewed-primary-refs.mjs",
    "knowledge:validate": "node scripts/validate-knowledge.mjs",
    "knowledge:assets:check": "pnpm --filter @wavekb/web assets:check"
  }
}
