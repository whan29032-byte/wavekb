# Discord Bot Token。只填写在本地 .env，切勿提交或发到聊天中。
TOKEN=
CLIENT_ID=1545138494131666964
# 可选：开发时填写测试服务器 ID，斜杠命令会立即更新到该服务器。
GUILD_ID=
# 可选：新成员欢迎与阵营选择消息的发送频道；留空使用当前服务器的入学登记处。
WELCOME_CHANNEL_ID=1545734710888632411
# 可选：主题服务器及路线身份角色。三项必须同时填写；应用主题后由 dry-run 输出实际角色 ID。
THEME_GUILD_ID=
SCIENCE_ROLE_ID=
MAGIC_ROLE_ID=
# 可选：科学侧与魔法侧各六个成长角色 ID，按阶段 0 到 5 用英文逗号分隔；两项必须同时填写。
SCIENCE_GROWTH_ROLE_IDS=
MAGIC_GROWTH_ROLE_IDS=
# 可选：无法直连 Discord 时填写 HTTP(S) 代理，例如 http://127.0.0.1:7897
PROXY_URL=
DATABASE_PATH=data/profile-bot.db

# WaveKB 网站账号绑定与积分玩法 API。前三项必须同时填写；密钥只放在本地 .env。
WEBSITE_API_URL=
# 可选：用户浏览器打开的公开 HTTP(S) 来源；留空时沿用 WEBSITE_API_URL。
WEBSITE_PUBLIC_URL=
# 与网站 DISCORD_BOT_API_SECRET 相同，必须至少 32 个 UTF-8 字节。
WEBSITE_BOT_API_SECRET=
WEBSITE_GUILD_ID=
# 可选：绑定成功后添加的普通角色，以及“网站称号 -> 普通角色 ID”的 JSON 对象。
WEBSITE_LINKED_ROLE_ID=
WEBSITE_TITLE_ROLE_MAP={}
