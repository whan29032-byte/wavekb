diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..651f5704481ea78b9df874c13093a4778647e85f
--- /dev/null
+++ b/lib/depth.js	
@@ -0,0 +1,59 @@
+'use strict';
+
+// Local backport for GHSA-vfj7-8cjw-p6xm. Keep recursive walkers well below
+// the JavaScript stack limit, including when callers pass an AST directly.
+const MAX_DEPTH = 100;
+const MAX_NODES = 20000;
+
+const assertDepth = depth => {
+  if (depth > MAX_DEPTH) {
+    const error = new SyntaxError(`Brace pattern nesting exceeds maximum depth (${MAX_DEPTH})`);
+    error.code = 'BRACES_MAX_DEPTH';
+    throw error;
+  }
+};
+
+const assertAst = ast => {
+  const active = new WeakSet();
+  const stack = [{ node: ast, depth: 0, leave: false }];
+  let count = 0;
+
+  // This validation is deliberately iterative: validating a hostile AST must
+  // not reproduce the recursive stack exhaustion it is intended to prevent.
+  while (stack.length > 0) {
+    const frame = stack.pop();
+    const node = frame.node;
+    if (!node || typeof node !== 'object') {
+      throw new TypeError('Expected an AST node');
+    }
+    if (frame.leave) {
+      active.delete(node);
+      continue;
+    }
+    if (++count > MAX_NODES) {
+      const error = new SyntaxError(`Brace AST exceeds maximum nodes (${MAX_NODES})`);
+      error.code = 'BRACES_MAX_NODES';
+      throw error;
+    }
+    if (active.has(node)) {
+      const error = new SyntaxError('Brace AST contains a cycle');
+      error.code = 'BRACES_INVALID_AST';
+      throw error;
+    }
+    if (Array.isArray(node.nodes)) {
+      assertDepth(frame.depth);
+      if (node.nodes.length + count > MAX_NODES) {
+        const error = new SyntaxError(`Brace AST exceeds maximum nodes (${MAX_NODES})`);
+        error.code = 'BRACES_MAX_NODES';
+        throw error;
+      }
+      active.add(node);
+      stack.push({ node, depth: frame.depth, leave: true });
+      for (let index = node.nodes.length - 1; index >= 0; index--) {
+        stack.push({ node: node.nodes[index], depth: frame.depth + 1, leave: false });
+      }
+    }
+  }
+};
+
+module.exports = { assertDepth, assertAst };
