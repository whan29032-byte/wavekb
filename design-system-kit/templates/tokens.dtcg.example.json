{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "primitive": {
    "color": {
      "brand": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1451, 0.3882, 0.9216],
          "hex": "#2563EB"
        }
      },
      "surfaceLight": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#FFFFFF"
        }
      },
      "surfaceDark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0431, 0.0588, 0.0980],
          "hex": "#0B0F19"
        }
      }
    },
    "space": {
      "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } }
    }
  },
  "themes": {
    "light": {
      "surface": { "page": { "$type": "color", "$value": "{primitive.color.surfaceLight}" } },
      "action": { "primary": { "$type": "color", "$value": "{primitive.color.brand}" } }
    },
    "dark": {
      "surface": { "page": { "$type": "color", "$value": "{primitive.color.surfaceDark}" } },
      "action": { "primary": { "$type": "color", "$value": "{primitive.color.brand}" } }
    }
  },
  "component": {
    "button": {
      "paddingInline": { "$type": "dimension", "$value": "{primitive.space.4}" }
    }
  }
}
