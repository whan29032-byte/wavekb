PORT=8787
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server
SUPABASE_PUBLISHABLE_KEY=replace-on-server
AI_SECRET_MASTER_KEY=replace-with-32-random-bytes-base64
AUTH_SITE_URL=http://SERVER_IP/
AUTH_LOGIN_LIMIT_PER_15_MINUTES=8
AUTH_UID_ACTION_LIMIT_PER_HOUR=12
AUTH_FEATURE_ENABLED=false
ALLOWED_WEB_ORIGINS=http://SERVER_IP
ALLOWED_PROVIDER_HOSTS=
ALLOWED_LOCAL_PROVIDER_HOSTS=
AI_DAILY_USER_LIMIT=20
# Disabled by default; never use a user's BYOK key as the platform provider key.
MEMBERSHIP_MANAGED_AI_ENABLED=false
# Wallet verification shares the AI worker service but has an independent loop.
# Keep disabled until addresses, RPC providers and live acceptance are verified.
MEMBERSHIP_WALLET_ENABLED=false
MEMBERSHIP_WALLET_ETHEREUM_RPC_URL=
MEMBERSHIP_WALLET_BASE_RPC_URL=
MEMBERSHIP_WALLET_RPC_ALLOWED_HOSTS=
MEMBERSHIP_WALLET_TRONGRID_API_KEY=
MEMBERSHIP_WALLET_VERIFY_BATCH_SIZE=2
AI_MAX_IMAGE_BYTES=10485760
BINANCE_FUTURES_API_URL=https://fapi.binance.com
TRADING_SYNC_MINUTES=15
# Optional, separate business email. Never configure credentials in Git.
MENTOR_EMAIL_ENABLED=false
MENTOR_EMAIL_API_KEY=
MENTOR_EMAIL_FROM=
MENTOR_EMAIL_SITE_URL=https://wavekb.com
MENTOR_EMAIL_POLL_SECONDS=15
# Optional YouTube publishing. Keep disabled until Google OAuth configuration.
YOUTUBE_SYNC_ENABLED=false
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://wavekb.com/api/youtube/callback
YOUTUBE_TOKEN_MASTER_KEY=
YOUTUBE_SYNC_POLL_SECONDS=600
YOUTUBE_SYNC_MAX_PAGES_PER_CONNECTION=2
YOUTUBE_SYNC_MAX_CALLS_PER_POLL=20
YOUTUBE_SYNC_BATCH_SIZE=50
