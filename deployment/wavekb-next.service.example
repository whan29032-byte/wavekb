[Unit]
Description=WaveKB Next.js preview
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=DEPLOY_USER
WorkingDirectory=/srv/wavekb-next-preview/current
EnvironmentFile=/etc/wavekb/next-preview.env
ExecStart=/usr/bin/node apps/web/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/wavekb-next-preview
UMask=0027

[Install]
WantedBy=multi-user.target
