NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTH_GATEWAY_INTERNAL_URL=http://127.0.0.1:8787
AUTH_GATEWAY_PUBLIC_ORIGIN=https://wavekb.com
NEXT_PUBLIC_LEGACY_SITE_URL=https://wavekb.com
DEPLOYMENT_VERSION=local
PORT=3100
HOSTNAME=127.0.0.1

# WaveKB TradeX pilot. Keep the chart on a separate HTTPS origin; never place credentials there.
WORKBENCH_LIVE_MARKET_ORIGIN=
WORKBENCH_LIVE_MARKET_ENABLED=false
WORKBENCH_LIVE_MARKET_PILOT_UIDS=
WORKBENCH_LIVE_MARKET_PUBLIC_ENABLED=false

# Server-only Tline credential. Never prefix with NEXT_PUBLIC_.
TLINE_API_KEY=

# Server-only Discord bot integration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Must match the bot WEBSITE_BOT_API_SECRET and contain at least 32 UTF-8 bytes.
DISCORD_BOT_API_SECRET=
DISCORD_BOT_GUILD_ID=
DISCORD_LINK_PUBLIC_ORIGIN=https://wavekb.com

# Only used by the final authenticated Playwright acceptance suite.
E2E_POSTING_IDENTIFIER=
E2E_POSTING_PASSWORD=
E2E_PILOT_BINANCE_TRADE_ID=
TRADING_TRADEX_ACCEPTANCE=0
